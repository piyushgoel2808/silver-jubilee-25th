# Google Drive OAuth2 Backend Configuration (Zero ₹ Cost Host Drive)
# Obtain from Google Cloud Console > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_oauth2_refresh_token_here

# Google Drive Folder IDs
# GOOGLE_DRIVE_HOST_FOLDER_ID: Folder containing high-res family photos and Google Flow AI videos
GOOGLE_DRIVE_HOST_FOLDER_ID=your_host_curated_folder_id_here

# GOOGLE_DRIVE_GUEST_FOLDER_ID: Folder where guests upload their live photos + heartfelt wishes
GOOGLE_DRIVE_GUEST_FOLDER_ID=your_live_guest_uploads_folder_id_here

# Public base URL (for WhatsApp RSVP & .ics link sharing)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
